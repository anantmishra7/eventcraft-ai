# ==============================================================================
# EventCraft AI - Environment Configuration Example
# Copy this file to .env in your root or server folder before starting the app.
# Note: In Demo Mode, an API key is NOT required. The app will automatically
# supply high-fidelity realistic event plans when no key is provided.
# ==============================================================================

# Server Port
PORT=5000

# Client Application URL (for CORS allow-list)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key
# Obtain your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Node Environment
NODE_ENV=development

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AI_RATE_LIMIT_MAX_REQUESTS=20

# Cache TTL (in milliseconds - default: 1 hour)
CACHE_TTL_MS=3600000
